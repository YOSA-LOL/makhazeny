# =============================================================================
# Makhazeny (مخازني) — Environment Configuration (Example)
# =============================================================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# cp .env.example .env
# =============================================================================

# وضع التطبيق: server | client
APP_MODE=server

# إعدادات السيرفر (Server Mode)
SERVER_HOST=0.0.0.0
SERVER_PORT=4000

# عنوان السيرفر البعيد (Client Mode)
SERVER_URL=http://192.168.1.100:4000

# =============================================================================
# MySQL Database
# =============================================================================
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=makhazeny
MYSQL_PORT=3306

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_DATABASE=makhazeny
DB_PORT=3306

DATABASE_URL=mysql://root:your_password_here@localhost:3306/makhazeny

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# =============================================================================
# Development
# =============================================================================
PORT=8080
FRONTEND_PORT=25085
BASE_PATH=/
NODE_ENV=development
LOG_LEVEL=info
