generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Users and Authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}

// Products and Inventory
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  sku             String    @unique
  description     String?   @db.Text
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  purchasePrice   Decimal   @db.Decimal(12, 2)
  sellingPrice    Decimal   @db.Decimal(12, 2)
  quantity        Int       @default(0)
  lowStockLevel   Int       @default(10)
  barcode         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  salesItems      SalesItem[]
  inventoryLog    InventoryLog[]

  @@index([categoryId])
  @@index([sku])
  @@index([name])
}

model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      InventoryType
  quantity  Int
  notes     String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

enum InventoryType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

// Customers and Sales
model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  city        String?
  creditLimit Decimal  @db.Decimal(12, 2) @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sales       Sale[]
  debts       Debt[]
  payments    Payment[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Sale {
  id              String    @id @default(cuid())
  saleNumber      String    @unique
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalAmount     Decimal   @db.Decimal(12, 2)
  paidAmount      Decimal   @db.Decimal(12, 2) @default(0)
  status          SaleStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  items           SalesItem[]
  debt            Debt?
  treasuryTransactions TreasuryTransaction[] @relation("SaleTransaction")

  @@index([customerId])
  @@index([saleNumber])
  @@index([createdAt])
  @@index([status])
}

model SalesItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

enum SaleStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  CHECK
  TRANSFER
  OTHER
}

// Suppliers
model Supplier {
  id       String   @id @default(cuid())
  name     String
  phone    String?
  email    String?
  address  String?
  city     String?
  balance  Decimal  @db.Decimal(12, 2) @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases PurchaseOrder[]
  payments SupplierPayment[]
  treasuryTransactions TreasuryTransaction[] @relation("SupplierTransaction")

  @@index([name])
  @@index([phone])
  @@index([email])
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  totalAmount Decimal  @db.Decimal(12, 2)
  paidAmount  Decimal  @db.Decimal(12, 2) @default(0)
  status      OrderStatus @default(PENDING)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       PurchaseItem[]

  @@index([supplierId])
  @@index([poNumber])
  @@index([createdAt])
}

model PurchaseItem {
  id            String         @id @default(cuid())
  purchaseId    String
  purchase      PurchaseOrder  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String?
  quantity      Int
  price         Decimal        @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())

  @@index([purchaseId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

// Debts and Payments
model Debt {
  id          String   @id @default(cuid())
  saleId      String   @unique
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  originalAmount Decimal @db.Decimal(12, 2)
  remainingAmount Decimal @db.Decimal(12, 2)
  dueDate     DateTime?
  status      DebtStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payments    Payment[]

  @@index([customerId])
  @@index([saleId])
  @@index([status])
}

enum DebtStatus {
  ACTIVE
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model Payment {
  id         String   @id @default(cuid())
  debtId     String
  debt       Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     PaymentMethod @default(CASH)
  reference  String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  treasuryTransactions TreasuryTransaction[] @relation("PaymentTransaction")

  @@index([debtId])
  @@index([customerId])
  @@index([createdAt])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  purchaseId String?
  amount     Decimal  @db.Decimal(12, 2)
  method     PaymentMethod @default(CASH)
  reference  String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  treasuryTransactions TreasuryTransaction[] @relation("SupplierPaymentTransaction")

  @@index([supplierId])
  @@index([purchaseId])
  @@index([createdAt])
}

// Returns
model Return {
  id        String   @id @default(cuid())
  returnNumber String  @unique
  saleId    String
  customerId String
  totalAmount Decimal @db.Decimal(12, 2)
  reason    ReturnReason
  status    ReturnStatus @default(PENDING)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     ReturnItem[]
  treasuryTransactions TreasuryTransaction[] @relation("ReturnTransaction")

  @@index([saleId])
  @@index([customerId])
  @@index([returnNumber])
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  CUSTOMER_REQUEST
  DAMAGE
  OTHER
}

enum ReturnStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

model ReturnItem {
  id       String @id @default(cuid())
  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  quantity Int
  amount   Decimal @db.Decimal(12, 2)

  @@index([returnId])
  @@index([productId])
}

// Expenses
model Expense {
  id          String   @id @default(cuid())
  category    ExpenseCategory
  description String   @db.Text
  amount      Decimal  @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  reference   String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  treasuryTransactions TreasuryTransaction[] @relation("ExpenseTransaction")

  @@index([category])
  @@index([createdAt])
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARY
  MAINTENANCE
  OFFICE_SUPPLIES
  TRANSPORT
  INSURANCE
  MARKETING
  OTHER
}

// Treasury / Cash Register System
model Treasury {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date
  openingBalance  Decimal  @db.Decimal(12, 2) @default(0)
  closingBalance  Decimal  @db.Decimal(12, 2) @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  transactions    TreasuryTransaction[]
  dailyBalance    DailyBalanceHistory?

  @@index([date])
}

model TreasuryTransaction {
  id              String   @id @default(cuid())
  treasuryId      String
  treasury        Treasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  type            TransactionType
  amount          Decimal  @db.Decimal(12, 2)
  description     String   @db.Text
  
  // Source tracking - only one of these should be populated
  saleId          String?
  sale            Sale?    @relation("SaleTransaction", fields: [saleId], references: [id], onDelete: SetNull)
  paymentId       String?
  payment         Payment? @relation("PaymentTransaction", fields: [paymentId], references: [id], onDelete: SetNull)
  supplierPaymentId String?
  supplierPayment SupplierPayment? @relation("SupplierPaymentTransaction", fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier? @relation("SupplierTransaction", fields: [supplierId], references: [id], onDelete: SetNull)
  returnId        String?
  return          Return?  @relation("ReturnTransaction", fields: [returnId], references: [id], onDelete: SetNull)
  expenseId       String?
  expense         Expense? @relation("ExpenseTransaction", fields: [expenseId], references: [id], onDelete: SetNull)
  
  reference       String?
  createdAt       DateTime @default(now())

  @@index([treasuryId])
  @@index([type])
  @@index([createdAt])
  @@index([saleId])
  @@index([paymentId])
  @@index([supplierId])
}

enum TransactionType {
  SALES_INCOME
  INSTALLMENT_PAYMENT
  SUPPLIER_PAYMENT
  RETURN_REFUND
  MANUAL_EXPENSE
  MANUAL_INCOME
}

model DailyBalanceHistory {
  id            String   @id @default(cuid())
  treasuryId    String   @unique
  treasury      Treasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  openingBalance Decimal  @db.Decimal(12, 2)
  closingBalance Decimal  @db.Decimal(12, 2)
  dailyIncome   Decimal  @db.Decimal(12, 2) @default(0)
  dailyExpense  Decimal  @db.Decimal(12, 2) @default(0)
  dailyProfit   Decimal  @db.Decimal(12, 2) @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  type      NotificationType
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  LOW_STOCK
  OVERDUE_DEBT
  PAYMENT_RECEIVED
  SUPPLIER_PAYMENT_DUE
  SYSTEM_ALERT
}
